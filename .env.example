# Database Configuration
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git

# PostgreSQL Database URL (required)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/smart_pantry

# Or use POSTGRES_URL instead
# POSTGRES_URL=postgresql://user:password@localhost:5432/smart_pantry

# NextAuth Configuration (required for authentication)
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google Gemini API (required for AI recipe generation)
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Configuration (required for image storage)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Image Generation Monthly Limit (optional, defaults to 100)
IMAGE_GENERATION_MONTHLY_LIMIT=100

# Optional: Redis for production rate limiting
# REDIS_URL=your-redis-url-here
